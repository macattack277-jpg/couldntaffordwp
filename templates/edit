<!DOCTYPE html>
<h1>Edit Post</h1>
{% with messages = get_flashed_messages() %}
{% if messages %}
	{% for message in messages %}
		{{message}}
	{% endfor %}
{% endif %}
{% endwith %}
<head>
</head>


<body>
	<form method="POST">
		<textarea name="title" rows=1 cols=100>{{ g.title }}</textarea>
		<br>
		<textarea name="content" rows=30 cols=100>{{ g.content }}</textarea>
		<br>
		<input type="submit">
	</form>

	<br>
	<a href='/delete/posts/{{ g.title  }}'>Delete this post</a>
</body>




</html>
