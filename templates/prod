<!DOCTYPE html>
<h1>Post Something New!</h1>
{% with messages = get_flashed_messages() %}
{% if messages %}
	{% for message in messages %}
		{{message}}
	{% endfor %}
{% endif %}
{% endwith %}
<head>
</head>


